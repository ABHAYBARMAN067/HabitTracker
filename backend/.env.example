NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/habit-tracker
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=https://your-frontend-domain.example
# SMTP configuration (Gmail users should create an App Password, not use their normal password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-smtp-app-password
MAIL_FROM="HabitFlow <your-email@gmail.com>"
